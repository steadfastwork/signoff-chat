# =============================================================================
# Signoff Chat — Mobile (Expo)
# Copy to .env.local for local development.
# All EXPO_PUBLIC_ vars are inlined by Metro at build time (public).
# =============================================================================

# URL of the deployed Next.js web app (no trailing slash)
EXPO_PUBLIC_API_URL=https://your-app.vercel.app

# Soketi self-hosted real-time server
EXPO_PUBLIC_SOKETI_KEY=your-soketi-app-key
EXPO_PUBLIC_SOKETI_HOST=soketi.your-domain.com

# Stripe (publishable key — safe to expose)
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-publishable-key
