{
  "name": "@signoff/gateway",
  "version": "0.1.0",
  "private": true,
  "description": "SIGNOFF protocol gateway — per-user OSCAR (TOC2) sessions relayed to Pusher.",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "pusher": "^5.2.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0"
  }
}
