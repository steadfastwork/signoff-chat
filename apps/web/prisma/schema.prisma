generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum UserStatus {
  ONLINE
  AWAY
  IDLE
  INVISIBLE
  OFFLINE
}

enum PostPrivacy {
  PUBLIC
  BUDDIES_ONLY
}

enum BuddyStatus {
  PENDING
  ACCEPTED
  BLOCKED
}

enum ChannelType {
  PUBLIC
  INVITE_ONLY
  SECRET
}

enum BoardType {
  PUBLIC
  INVITE_ONLY
  SECRET
}

enum MediaType {
  IMAGE
  VIDEO
  GIF
}

enum ReportReason {
  SPAM
  HARASSMENT
  CSAM
  THREAT
  IMPERSONATION
  OTHER
}

enum ReportStatus {
  PENDING
  REVIEWED
  ACTIONED
  DISMISSED
}

enum AdminRole {
  ADMIN
  SUPER_ADMIN
}

enum FeedVisibility {
  PUBLIC    // anyone can see posts
  BUDDIES   // only accepted buddies can see posts
  PRIVATE   // only the user themselves can see posts
}

enum BadgeType {
  FOUNDER
  FOUNDING_DONOR
}

enum PostType {
  AWAY    // The existing away message (away message feed)
  THOUGHT // Long-form text post (like a Tumblr text post)
  QUOTE   // A quote with optional attribution
  PHOTO   // An image with optional caption
}

enum ChannelCategory {
  GAMING
  MUSIC
  ART
  TECH
  SPORTS
  POLITICS
  HUMOR
  LIFESTYLE
  STUDY
  SUPPORT
  NSFW
  OTHER
}

// ---------------------------------------------------------------------------
// User
// ---------------------------------------------------------------------------

model User {
  id           String     @id @default(cuid())
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  screenname   String     @unique
  // Email is never stored in plaintext.
  // emailHash = sha256(normalize(email) + EMAIL_PEPPER) — see lib/crypto/email.ts
  emailHash    String     @unique
  passwordHash String
  bio          String?    @db.VarChar(160)
  awayMessage      String?    @db.VarChar(140)
  awayMessageSetAt DateTime?
  currently        Json?      @default("{}")
  status       UserStatus @default(OFFLINE)
  // lastSeen intentionally omitted — we do not record activity timestamps.
  // See PRIVACY-ARCHITECTURE.md §4.
  isGoldMember      Boolean    @default(false)
  adminRole         AdminRole?
  adminNotes        String?    // internal only, never shown to user
  profileTheme      String?
  avatarUrl         String?    // Gold only — UploadThing CDN URL
  soundPack         String?    // Gold only: "classic" | "retro" | "minimal" | null (= off)
  stripeCustomerId  String?    @unique

  // Encrypted email for digest delivery — stored separately from emailHash
  emailEncrypted     String?  // AES-256-GCM encrypted email (base64)
  emailNonce         String?  // 12-byte IV (base64)

  // Email verification
  emailVerified                   DateTime?
  emailVerificationToken          String?   @unique
  emailVerificationTokenExpiresAt DateTime?

  // Digest settings
  digestEnabled      Boolean  @default(false)
  digestTime         String   @default("09:00")   // "HH:MM" 24h local time
  digestTimezone     String   @default("UTC")
  digestLastSentAt   DateTime?

  // Push notifications — cleared on logout and account deletion
  expoPushToken   String?

  // Safety / moderation
  isSuspended     Boolean   @default(false)
  suspendedAt     DateTime?
  suspendedUntil  DateTime? // null = permanent
  suspendReason   String?
  warningCount    Int       @default(0)

  // Post-quantum encryption
  mlkemPublicKey     String?   // base64 ML-KEM-1024 public key (1568 bytes); secret key lives client-side only
  hasConfirmedBackup Boolean   @default(false)  // user has saved their 24-word recovery phrase

  // Onboarding
  onboardingComplete  Boolean @default(false)
  onboardingStep      Int     @default(0)   // 0=welcome,1=account,2=keys,3=away,4=find-friends,5=done
  aimScreennameHash   String?               // SHA-256 of normalized old AIM screenname (optional, privacy-preserving)

  // DM text style preferences (feature flag: DM_FONT_COLORS)
  dmTextColor  String?  @default("#c8860a") // hex from DM_COLOR_PALETTE
  dmFontSize   String?  @default("md")      // "sm" | "md" | "lg"

  // Feed privacy
  feedVisibility     FeedVisibility @default(PUBLIC)

  posts               Post[]           @relation("AuthoredPosts")
  replies             Reply[]
  nudges              Nudge[]
  sentRequests        BuddyRelation[]  @relation("Requester")
  receivedRequests    BuddyRelation[]  @relation("Addressee")
  createdChannels     Channel[]
  channelMemberships  ChannelMember[]
  channelMessages     ChannelMessage[]
  sentTips            Tip[]            @relation("TipSender")
  receivedTips        Tip[]            @relation("TipRecipient")
  createdBoards       Board[]
  boardMemberships    BoardMember[]
  boardPosts          BoardPost[]
  boardComments       BoardComment[]
  boardNudges         BoardNudge[]
  boardCommentNudges  BoardCommentNudge[]
  channelThreadMessages    ChannelThreadMessage[]
  savedBoardPosts          SavedBoardPost[]
  favoriteChannels         FavoriteChannel[]
  buddyGroupLists          BuddyGroupList[]
  awayHistory              AwayMessageHistory[]
  awayNudges               AwayNudge[]
  badges                   UserBadge[]

  // Safety relations
  blocking          Block[]          @relation("Blocker")
  blockedBy         Block[]          @relation("Blocked")
  muting            Mute[]           @relation("Muter")
  mutedBy           Mute[]           @relation("Muted")
  reports           Report[]         @relation("Reporter")
  safetyIncidents   SafetyIncident[] @relation("Uploader")

  @@map("users")
}

// ---------------------------------------------------------------------------
// UserBadge
// ---------------------------------------------------------------------------

model UserBadge {
  id          String    @id @default(cuid())
  userId      String
  badge       BadgeType
  awardedAt   DateTime  @default(now())
  awardedById String
  note        String?
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, badge])
  @@index([badge])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// AwayMessageHistory  (every away message set by a user, ordered by setAt)
// ---------------------------------------------------------------------------

model AwayMessageHistory {
  id         String         @id @default(cuid())
  setAt      DateTime       @default(now())
  content    String         @db.VarChar(140)
  userId     String
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  visibility FeedVisibility @default(PUBLIC)
  nudgeCount Int            @default(0)
  replyCount Int            @default(0)

  // New post-type fields (RADICAL_UX)
  postType     PostType @default(AWAY)
  bodyText     String?  // For THOUGHT posts (no char limit)
  quoteText    String?  // For QUOTE posts — the actual quote
  quoteAttrib  String?  // For QUOTE posts — "— Author Name"
  imageUrl     String?  // For PHOTO posts — uploaded image URL
  imageCaption String?  // For PHOTO posts — optional caption
  tags         String[] // Hashtags without the # symbol
  echoOfId     String?  // If this is an echo of another post
  echoOf       AwayMessageHistory?  @relation("PostEchoes", fields: [echoOfId], references: [id], onDelete: SetNull)
  echoes       AwayMessageHistory[] @relation("PostEchoes")
  echoCount    Int      @default(0)
  editedAt     DateTime? // null = never edited; updated on each PATCH

  nudges   AwayNudge[]
  postTags PostTag[]

  @@index([userId, setAt(sort: Desc)])
  @@map("away_message_history")
}

// ---------------------------------------------------------------------------
// AwayNudge  (one per user per away message history entry)
// ---------------------------------------------------------------------------

model AwayNudge {
  id        String             @id @default(cuid())
  createdAt DateTime           @default(now())
  userId    String
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  awayId    String
  away      AwayMessageHistory @relation(fields: [awayId], references: [id], onDelete: Cascade)

  @@unique([userId, awayId])
  @@map("away_nudges")
}

// ---------------------------------------------------------------------------
// PostTag  (denormalized tag index for discovery — one row per tag per post)
// ---------------------------------------------------------------------------

model PostTag {
  id        String             @id @default(cuid())
  tag       String             // e.g. "slowliving" (no # prefix stored)
  postId    String
  post      AwayMessageHistory @relation(fields: [postId], references: [id], onDelete: Cascade)
  createdAt DateTime           @default(now())

  @@index([tag])
  @@index([postId])
  @@map("post_tags")
}

// ---------------------------------------------------------------------------
// Post
// ---------------------------------------------------------------------------

model Post {
  id            String      @id @default(cuid())
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  content       String
  authorId      String
  author        User        @relation("AuthoredPosts", fields: [authorId], references: [id], onDelete: Cascade)
  privacy       PostPrivacy @default(PUBLIC)
  isAwayMessage Boolean     @default(false)
  // Legacy single-media fields (kept for migration safety — use arrays below)
  mediaUrl      String?
  mediaType     MediaType?
  // Multi-media arrays
  mediaUrls     String[]    // UploadThing CDN image/video URLs
  gifUrls       String[]    // Giphy CDN URLs
  gifIds        String[]    // Giphy IDs for attribution

  replies       Reply[]
  nudges        Nudge[]

  @@map("posts")
}

// ---------------------------------------------------------------------------
// Reply
// ---------------------------------------------------------------------------

model Reply {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  content   String   @db.VarChar(256)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@map("replies")
}

// ---------------------------------------------------------------------------
// Nudge  (one per user per post)
// ---------------------------------------------------------------------------

model Nudge {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@map("nudges")
}

// ---------------------------------------------------------------------------
// BuddyRelation
// No timestamp — we do not record when friendships formed. See §3.
// On DECLINE or WITHDRAW: hard delete immediately (no soft state).
// ---------------------------------------------------------------------------

model BuddyRelation {
  id          String      @id @default(cuid())
  requesterId String
  requester   User        @relation("Requester", fields: [requesterId], references: [id], onDelete: Cascade)
  addresseeId String
  addressee   User        @relation("Addressee", fields: [addresseeId], references: [id], onDelete: Cascade)
  status      BuddyStatus @default(PENDING)

  @@unique([requesterId, addresseeId])
  @@map("buddy_relations")
}

// ---------------------------------------------------------------------------
// Channel  (formerly Room)
// ---------------------------------------------------------------------------

model Channel {
  id              String      @id @default(cuid())
  createdAt       DateTime    @default(now())
  name            String      @unique
  description     String?
  isPrivate       Boolean     @default(false)
  creatorId       String
  creator         User        @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  type            ChannelType @default(PUBLIC)
  slowModeMinutes Int         @default(10)
  memberCap       Int?

  tags            String[]
  // Discovery fields
  category        ChannelCategory?
  memberCount     Int             @default(0)
  messageCount    Int             @default(0)
  lastActiveAt    DateTime?
  isFeatured      Boolean         @default(false)
  isVerified      Boolean         @default(false)
  // DM channels (one-on-one direct messages)
  isDM            Boolean         @default(false)

  members         ChannelMember[]
  messages        ChannelMessage[]
  threads         ChannelThread[]
  inviteLinks     InviteLink[]
  channelKeys     ChannelKey[]
  bans            ChannelBan[]
  favorites       FavoriteChannel[]

  @@map("rooms")
}

// ---------------------------------------------------------------------------
// BuddyGroupList
// ---------------------------------------------------------------------------

model BuddyGroupList {
  id        String             @id @default(cuid())
  createdAt DateTime           @default(now())
  name      String
  ownerId   String
  owner     User               @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  position  Int                @default(0)
  members   BuddyGroupMember[]

  @@map("buddy_group_lists")
}

model BuddyGroupMember {
  listId  String
  list    BuddyGroupList @relation(fields: [listId], references: [id], onDelete: Cascade)
  buddyId String

  @@id([listId, buddyId])
  @@map("buddy_group_members")
}

// ---------------------------------------------------------------------------
// FavoriteChannel
// ---------------------------------------------------------------------------

model FavoriteChannel {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  channelId String
  channel   Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@unique([userId, channelId])
  @@map("favorite_channels")
}

// ---------------------------------------------------------------------------
// ChannelMember  (formerly RoomMember)
// ---------------------------------------------------------------------------

model ChannelMember {
  id            String    @id @default(cuid())
  joinedAt      DateTime  @default(now())
  lastMessageAt DateTime?
  lastReadAt    DateTime?
  mutedUntil    DateTime?
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  channelId     String
  channel       Channel   @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@unique([userId, channelId])
  @@map("room_members")
}

// ---------------------------------------------------------------------------
// ChannelMessage  (formerly RoomMessage)
// ---------------------------------------------------------------------------

model ChannelMessage {
  id        String     @id @default(cuid())
  createdAt DateTime   @default(now())
  content   String
  mediaUrl  String?
  mediaType MediaType?
  authorId  String
  author    User       @relation(fields: [authorId], references: [id], onDelete: Cascade)
  channelId String
  channel   Channel    @relation(fields: [channelId], references: [id], onDelete: Cascade)

  // GIPHY gif fields (set when message is a gif, content is empty)
  gifId    String?
  gifUrl   String?
  gifTitle String?

  // Message expiry (§6) — hard-deleted by cron at 3am UTC
  // Default: 30 days. Gold sender: 90 days. Delivered-to-all: 24h.
  expiresAt      DateTime @default(dbgenerated("now() + interval '30 days'"))
  deliveredToAll Boolean  @default(false)

  // Hybrid post-quantum encryption (AES-256-GCM + ML-KEM-1024)
  isEncrypted      Boolean @default(false)
  encryptedContent String?
  encapsulatedKey  String?
  iv               String?
  keyVersion       Int?

  // DM font color (feature flag: DM_FONT_COLORS) — stored per message
  textColor  String?  // hex value from DM_COLOR_PALETTE
  fontSize   String?  // "sm" | "md" | "lg"

  threads   ChannelThread[]

  @@map("room_messages")
}

// ---------------------------------------------------------------------------
// ChannelKey  (group session key per epoch)
// ---------------------------------------------------------------------------

model ChannelKey {
  id            String   @id @default(cuid())
  createdAt     DateTime @default(now())
  expiresAt     DateTime
  channelId     String
  channel       Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  encryptedKeys Json
  keyVersion    Int

  @@map("channel_keys")
}

// ---------------------------------------------------------------------------
// Tip
// ---------------------------------------------------------------------------

model Tip {
  id                    String   @id @default(cuid())
  createdAt             DateTime @default(now())
  amount                Int
  senderId              String
  sender                User     @relation("TipSender", fields: [senderId], references: [id], onDelete: Cascade)
  recipientId           String
  recipient             User     @relation("TipRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  message               String?  @db.VarChar(140)
  stripePaymentIntentId String

  @@map("tips")
}

// ---------------------------------------------------------------------------
// InviteLink
// No audit trail — we do not record who created or used a link. See §7.
// ---------------------------------------------------------------------------

model InviteLink {
  id            String    @id @default(cuid())
  createdAt     DateTime  @default(now())
  token         String    @unique
  channelId     String?
  channel       Channel?  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  boardId       String?
  board         Board?    @relation(fields: [boardId], references: [id], onDelete: Cascade)
  expiresAt     DateTime
  // usesRemaining replaces maxUses+useCount — decremented on each use,
  // record is hard-deleted when it reaches 0.
  usesRemaining Int       @default(10)
  isRevoked     Boolean   @default(false)

  @@map("invite_links")
}

// ---------------------------------------------------------------------------
// Board
// ---------------------------------------------------------------------------

// ---------------------------------------------------------------------------
// ChannelBan  (prevents rejoining after removal)
// ---------------------------------------------------------------------------

model ChannelBan {
  id        String  @id @default(cuid())
  channelId String
  channel   Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  userId    String

  @@unique([channelId, userId])
  @@map("channel_bans")
}

model Board {
  id             String    @id @default(cuid())
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  name           String    @unique
  displayName    String
  vibeStatement  String    @db.VarChar(200)
  type           BoardType @default(PUBLIC)
  creatorId      String
  creator        User      @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  memberCount    Int       @default(0)

  members        BoardMember[]
  posts          BoardPost[]
  inviteLinks    InviteLink[]
  bans           BoardBan[]

  @@map("boards")
}

// ---------------------------------------------------------------------------
// BoardMember
// ---------------------------------------------------------------------------

model BoardMember {
  id               String   @id @default(cuid())
  joinedAt         DateTime @default(now())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  boardId          String
  board            Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)
  isFoundingMember Boolean  @default(false)
  isModerator      Boolean  @default(false)

  @@unique([userId, boardId])
  @@map("board_members")
}

// ---------------------------------------------------------------------------
// BoardBan  (prevents rejoining a board after removal)
// ---------------------------------------------------------------------------

model BoardBan {
  id      String @id @default(cuid())
  boardId String
  board   Board  @relation(fields: [boardId], references: [id], onDelete: Cascade)
  userId  String

  @@unique([boardId, userId])
  @@map("board_bans")
}

// ---------------------------------------------------------------------------
// BoardPost
// ---------------------------------------------------------------------------

model BoardPost {
  id           String     @id @default(cuid())
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  title        String     @db.VarChar(140)
  body         String?    @db.VarChar(2000)
  authorId     String
  author       User       @relation(fields: [authorId], references: [id], onDelete: Cascade)
  boardId      String
  board        Board      @relation(fields: [boardId], references: [id], onDelete: Cascade)
  mediaUrl     String?
  mediaType    MediaType?
  tag          String?    @db.VarChar(30)
  isArchived   Boolean    @default(false)
  nudgeCount   Int        @default(0)
  commentCount Int        @default(0)

  // Hybrid post-quantum encryption — INVITE_ONLY and SECRET boards only
  isEncrypted    Boolean @default(false)
  encryptedBody  String?
  encapsulatedKey String?
  iv             String?

  comments     BoardComment[]
  nudges       BoardNudge[]
  savedBy      SavedBoardPost[]

  @@map("board_posts")
}

// ---------------------------------------------------------------------------
// BoardComment
// ---------------------------------------------------------------------------

model BoardComment {
  id              String   @id @default(cuid())
  createdAt       DateTime @default(now())
  body            String
  authorId        String
  author          User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  boardPostId     String
  boardPost       BoardPost @relation(fields: [boardPostId], references: [id], onDelete: Cascade)
  parentCommentId String?
  parentComment   BoardComment?  @relation("CommentReplies", fields: [parentCommentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  replies         BoardComment[] @relation("CommentReplies")

  nudges          BoardCommentNudge[]

  @@map("board_comments")
}

// ---------------------------------------------------------------------------
// BoardNudge  (one per user per board post)
// ---------------------------------------------------------------------------

model BoardNudge {
  id          String    @id @default(cuid())
  createdAt   DateTime  @default(now())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  boardPostId String
  boardPost   BoardPost @relation(fields: [boardPostId], references: [id], onDelete: Cascade)

  @@unique([userId, boardPostId])
  @@map("board_nudges")
}

// ---------------------------------------------------------------------------
// BoardCommentNudge  (one per user per board comment)
// ---------------------------------------------------------------------------

model BoardCommentNudge {
  id             String       @id @default(cuid())
  createdAt      DateTime     @default(now())
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  boardCommentId String
  boardComment   BoardComment @relation(fields: [boardCommentId], references: [id], onDelete: Cascade)

  @@unique([userId, boardCommentId])
  @@map("board_comment_nudges")
}

// ---------------------------------------------------------------------------
// ChannelThread  (threaded replies on channel messages)
// ---------------------------------------------------------------------------

model ChannelThread {
  id              String                @id @default(cuid())
  createdAt       DateTime              @default(now())
  parentMessageId String
  parentMessage   ChannelMessage        @relation(fields: [parentMessageId], references: [id], onDelete: Cascade)
  channelId       String
  channel         Channel               @relation(fields: [channelId], references: [id], onDelete: Cascade)
  messageCount    Int                   @default(0)

  messages        ChannelThreadMessage[]

  @@map("channel_threads")
}

// ---------------------------------------------------------------------------
// ChannelThreadMessage  (replies within a message thread)
// ---------------------------------------------------------------------------

model ChannelThreadMessage {
  id        String        @id @default(cuid())
  createdAt DateTime      @default(now())
  content   String        @db.VarChar(512)
  authorId  String
  author    User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  threadId  String
  thread    ChannelThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@map("channel_thread_messages")
}

// ---------------------------------------------------------------------------
// SavedBoardPost  (one per user per board post)
// ---------------------------------------------------------------------------

model SavedBoardPost {
  id          String    @id @default(cuid())
  createdAt   DateTime  @default(now())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  boardPostId String
  boardPost   BoardPost @relation(fields: [boardPostId], references: [id], onDelete: Cascade)

  @@unique([userId, boardPostId])
  @@map("saved_board_posts")
}

// ---------------------------------------------------------------------------
// Block  (unidirectional — A blocks B; B does not see A anywhere)
// No timestamps — we do not record when blocks were created.
// ---------------------------------------------------------------------------

model Block {
  id        String @id @default(cuid())
  blockerId String
  blocker   User   @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blockedId String
  blocked   User   @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@map("blocks")
}

// ---------------------------------------------------------------------------
// Mute  (unidirectional — A mutes B; B still sees A, A doesn't see B)
// No timestamps.
// ---------------------------------------------------------------------------

model Mute {
  id      String @id @default(cuid())
  muterId String
  muter   User   @relation("Muter", fields: [muterId], references: [id], onDelete: Cascade)
  mutedId String
  muted   User   @relation("Muted", fields: [mutedId], references: [id], onDelete: Cascade)

  @@unique([muterId, mutedId])
  @@map("mutes")
}

// ---------------------------------------------------------------------------
// Report
// CSAM reports trigger an immediate out-of-band email alert (see api/reports).
// All other reasons go into the staff review queue.
// ---------------------------------------------------------------------------

model Report {
  id           String       @id @default(cuid())
  createdAt    DateTime     @default(now())
  reporterId   String
  reporter     User         @relation("Reporter", fields: [reporterId], references: [id], onDelete: Cascade)
  // Exactly one of the following is set:
  targetUserId String?
  targetPostId String?
  targetMsgId  String?
  reason       ReportReason
  detail       String?      @db.VarChar(500)
  status       ReportStatus @default(PENDING)
  resolvedAt   DateTime?
  resolvedBy   String?      // admin userId who acted
  resolution   String?      // internal note on action taken

  @@map("reports")
}

// ---------------------------------------------------------------------------
// SafetyIncident
//
// Created by automated scanning (upload pipeline) or by user reports flagging
// CSAM/illegal content. The original file is deleted from storage immediately;
// this record and any preserved evidence copy persist for legal compliance.
//
// CSAM incidents trigger an NCMEC CyberTipline report within 24 hours
// (18 U.S.C. § 2258A). This table MUST NOT be deleted or truncated.
// ---------------------------------------------------------------------------

enum IncidentType {
  CSAM             // Confirmed/probable CSAM (hash match via PhotoDNA or Thorn)
  CSAM_SUSPECTED   // Scanner flagged as explicit; cannot confirm CSAM (Rekognition-only)
  ILLEGAL_CONTENT  // Other illegal content (non-CSAM)
  THREAT           // Credible threat of violence
  USER_REPORT      // Filed from a user report (human review required)
}

enum IncidentStatus {
  DETECTED          // Initial state — automated detection
  CONFIRMED         // Staff has reviewed and confirmed
  REPORTED_TO_NCMEC // NCMEC CyberTipline report successfully submitted
  CONTENT_REMOVED   // File deleted from storage
  ACCOUNT_SUSPENDED // Uploader account suspended
  RESOLVED          // All required actions taken
  FALSE_POSITIVE    // Staff reviewed and dismissed
}

model SafetyIncident {
  id              String         @id @default(cuid())
  createdAt       DateTime       @default(now())

  // Classification
  incidentType    IncidentType
  status          IncidentStatus @default(DETECTED)

  // Who filed it — either automated scanner (reporterId null) or a user report
  reporterId      String?        // User.id of human reporter (nullable = automated)

  // Uploader identity — retained even if account is later deleted (onDelete: SetNull)
  uploaderId      String?
  uploader        User?          @relation("Uploader", fields: [uploaderId], references: [id], onDelete: SetNull)
  uploaderName    String         // screenname snapshot at time of incident
  uploaderEmailHash String       // emailHash snapshot (hashed — no plaintext)

  // Content details — URL is the original pre-deletion URL
  contentUrl      String         // original UploadThing URL (no longer accessible)
  fileKey         String         // UploadThing key used to delete the file
  contentType     String         // MIME type (e.g. "image/jpeg")
  fileSizeBytes   Int?
  contentHash     String?        // SHA-256 hex of original file bytes

  // Scan results
  matchProvider   String?        // "PhotoDNA" | "ThornSafer" | "Rekognition" | "multi"
  matchConfidence Float?         // 0.0–1.0 normalised confidence
  allProviders    String?        // JSON array of ProviderResult for audit
  scannedAt       DateTime?

  // Actions taken (comma-separated log, e.g. "FILE_DELETED,ACCOUNT_SUSPENDED")
  actionsTaken    String?

  // Evidence preservation (S3 Object Lock — 7-year COMPLIANCE mode)
  preservedPath   String?        // S3 key of encrypted evidence copy
  preservedAt     DateTime?

  // NCMEC CyberTipline filing
  ncmecReportId   String?        // CyberTipline report number once filed
  ncmecReportedAt DateTime?      // When the report was submitted

  // Staff review
  resolvedAt      DateTime?
  resolvedBy      String?        // admin userId
  internalNotes   String?        @db.Text

  @@index([uploaderId])
  @@index([incidentType])
  @@index([status])
  @@index([ncmecReportedAt])
  @@map("safety_incidents")
}

// ---------------------------------------------------------------------------
// Admin Portal
// ---------------------------------------------------------------------------

model AdminAuditLog {
  id         String    @id @default(cuid())
  createdAt  DateTime  @default(now())
  adminId    String
  adminRole  AdminRole
  action     String
  targetId   String?
  targetType String?
  note       String?
  metadata   Json?

  @@map("admin_audit_logs")
}

model AdminGrant {
  id          String    @id @default(cuid())
  createdAt   DateTime  @default(now())
  grantedById String
  grantedToId String
  role        AdminRole
  reason      String
  revokedAt   DateTime?
  revokedById String?

  @@map("admin_grants")
}

model AdminSession {
  id         String   @id @default(cuid())
  adminId    String   @unique
  accessedAt DateTime @updatedAt

  @@map("admin_sessions")
}

model CronLog {
  id          String   @id @default(cuid())
  jobName     String
  ranAt       DateTime @default(now())
  success     Boolean
  message     String?
  durationMs  Int?
  triggeredBy String?

  @@map("cron_logs")
}

// ---------------------------------------------------------------------------
// Feature Flags
// ---------------------------------------------------------------------------

model FeatureFlag {
  id             String    @id @default(cuid())
  key            String    @unique
  enabled        Boolean   @default(false)
  description    String?
  enabledAt      DateTime?
  enabledBy      String?   // admin screenname
  updatedAt      DateTime  @updatedAt
  rolloutPercent Int       @default(0)  // 0-100; 100 = all users

  @@map("feature_flags")
}
