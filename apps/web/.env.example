# =============================================================================
# DATABASE
# =============================================================================
# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:password@localhost:5432/signoff_chat?schema=public"

# =============================================================================
# NEXTAUTH
# =============================================================================
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="your-nextauth-secret-here"
# Set to your app URL (no trailing slash)
NEXTAUTH_URL="http://localhost:3000"

# =============================================================================
# PRIVACY — Email hashing and IP rate-limit salt
# Generate EMAIL_PEPPER once with: openssl rand -hex 32
# CRITICAL: Never change EMAIL_PEPPER after launch — it would invalidate all
# stored emailHash values and lock out every user.
# RATE_LIMIT_SALT is rotated daily by /api/cron/rotate-rate-limit-salt.
# =============================================================================
EMAIL_PEPPER="your-64-char-hex-pepper-here"
RATE_LIMIT_SALT="your-32-char-hex-salt-here"

# SSM parameter name for automated salt rotation (optional)
# If set, the rotate cron will write the new salt directly to AWS SSM.
# RATE_LIMIT_SALT_SSM_PARAM="/signoff/rate-limit-salt"

# =============================================================================
# SOKETI (Self-hosted real-time server — Pusher protocol)
# Deploy Soketi on AWS ECS Fargate or any Docker host.
# Server vars (never exposed to browser):
# =============================================================================
SOKETI_APP_ID="your-soketi-app-id"
SOKETI_APP_KEY="your-soketi-app-key"
SOKETI_APP_SECRET="your-soketi-app-secret"
SOKETI_HOST="soketi.your-domain.com"

# Soketi public vars (exposed to browser for pusher-js client):
NEXT_PUBLIC_SOKETI_KEY="your-soketi-app-key"
NEXT_PUBLIC_SOKETI_HOST="soketi.your-domain.com"

# =============================================================================
# RESEND (Transactional email — password reset, notifications)
# Sign up at https://resend.com
# =============================================================================
RESEND_API_KEY="re_your-resend-api-key"

# =============================================================================
# UPLOADTHING (Profile image uploads)
# Sign up at https://uploadthing.com and create an app
# =============================================================================
UPLOADTHING_SECRET="sk_live_your-uploadthing-secret"
UPLOADTHING_APP_ID="your-uploadthing-app-id"

# =============================================================================
# STRIPE (Gold memberships + tips)
# Sign up at https://stripe.com — use test keys for development
# =============================================================================
STRIPE_SECRET_KEY="sk_test_your-stripe-secret-key"
STRIPE_WEBHOOK_SECRET="whsec_your-stripe-webhook-secret"
# Product price ID for the $4/month Gold subscription
STRIPE_GOLD_PRICE_ID="price_your-gold-price-id"

# Stripe publishable key (exposed to browser for Stripe Elements)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_your-stripe-publishable-key"

# =============================================================================
# HYBRID POST-QUANTUM ENCRYPTION
# Generate once with: openssl rand -hex 32
# CRITICAL: Never change this after launch — it would break all existing decryption.
# This is the HKDF domain-separation salt, NOT a secret. Safe to expose client-side.
# =============================================================================
NEXT_PUBLIC_ENCRYPTION_SALT="your-64-char-hex-string-here"

# =============================================================================
# CRON JOB AUTHENTICATION
# Sent as: Authorization: Bearer <secret>
# Generate with: openssl rand -base64 48
# =============================================================================
CRON_SECRET="your-cron-secret-here"

# =============================================================================
# UPSTASH REDIS — rate limiting
# Sign up at https://console.upstash.com and create a Redis database.
# Rate limiting is silently disabled in development if these are not set.
# =============================================================================
UPSTASH_REDIS_REST_URL="https://your-db.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-upstash-token"
