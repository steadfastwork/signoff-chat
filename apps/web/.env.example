# =============================================================================
# Signoff Chat — web app (apps/web)
# Copy to .env.local for local development. In production, set these in your
# host's environment settings (e.g. Vercel → Settings → Environment Variables).
# =============================================================================

# -----------------------------------------------------------------------------
# Database (Postgres — Neon, Supabase, Railway, local, …)
# -----------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres:password@localhost:5432/signoff_chat?schema=public"

# -----------------------------------------------------------------------------
# Auth (NextAuth)
# -----------------------------------------------------------------------------
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="your-nextauth-secret-here"
# Your app URL, no trailing slash
NEXTAUTH_URL="http://localhost:3000"

# -----------------------------------------------------------------------------
# Gateway (apps/gateway) — holds the AIM/ICQ + IRC sessions
# GATEWAY_SECRET must match the gateway's GATEWAY_SECRET.
# -----------------------------------------------------------------------------
GATEWAY_URL="http://localhost:8787"
# Generate with: openssl rand -hex 32
GATEWAY_SECRET="your-gateway-secret-here"

# -----------------------------------------------------------------------------
# Pusher Channels (real-time) — same app as the gateway
# pusher.com → your app → App Keys
# -----------------------------------------------------------------------------
PUSHER_APP_ID="your-pusher-app-id"
PUSHER_KEY="your-pusher-key"
PUSHER_SECRET="your-pusher-secret"
PUSHER_CLUSTER="us2"
NEXT_PUBLIC_PUSHER_KEY="your-pusher-key"
NEXT_PUBLIC_PUSHER_CLUSTER="us2"

# -----------------------------------------------------------------------------
# Privacy — email hashing (REQUIRED in production)
# Generate once with: openssl rand -hex 32
# Never change after launch: every stored email hash would stop matching.
# -----------------------------------------------------------------------------
EMAIL_PEPPER="your-64-char-hex-pepper-here"

# =============================================================================
# Optional
# =============================================================================

# Salt for hashing IPs in rate-limit keys (falls back to a dev salt if unset).
# /api/cron/rotate-rate-limit-salt generates a new one to apply.
RATE_LIMIT_SALT=""

# Protects the /api/cron/* routes. Generate with: openssl rand -base64 48
CRON_SECRET=""

# Upstash Redis — rate limiting is disabled when unset.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Cloudflare Turnstile on sign-up/login — skipped when unset.
CLOUDFLARE_TURNSTILE_SECRET_KEY=""
NEXT_PUBLIC_CLOUDFLARE_TURNSTILE_SITE_KEY=""
