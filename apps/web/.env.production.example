# =============================================================================
# signoff.chat — Production Environment Variables
# Copy this file to .env.production.local and fill in real values.
# Never commit .env.production.local to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# Next.js / Auth
# -----------------------------------------------------------------------------
NEXTAUTH_URL=https://signoff.chat
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=

# -----------------------------------------------------------------------------
# Database (Postgres — Neon, Supabase, Railway, etc.)
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://user:password@host:5432/signoff_chat?sslmode=require

# -----------------------------------------------------------------------------
# Pusher (real-time)
# Get these from pusher.com → your app → App Keys
# -----------------------------------------------------------------------------
PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
PUSHER_CLUSTER=mt1
NEXT_PUBLIC_PUSHER_KEY=
NEXT_PUBLIC_PUSHER_CLUSTER=mt1

# -----------------------------------------------------------------------------
# Stripe (payments)
# Use live keys in production, test keys in staging
# -----------------------------------------------------------------------------
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...
# Price ID for Gold plan monthly subscription
STRIPE_GOLD_PRICE_ID=price_...

# -----------------------------------------------------------------------------
# UploadThing (file uploads)
# Get from uploadthing.com → your app
# -----------------------------------------------------------------------------
UPLOADTHING_SECRET=sk_live_...
UPLOADTHING_APP_ID=

# -----------------------------------------------------------------------------
# Upstash Redis (rate limiting)
# Get from upstash.com → your database → REST API
# -----------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=

# -----------------------------------------------------------------------------
# Encryption
# Generate with: openssl rand -hex 32
# WARNING: changing this invalidates all existing encrypted messages
# -----------------------------------------------------------------------------
NEXT_PUBLIC_ENCRYPTION_SALT=

# -----------------------------------------------------------------------------
# Cron jobs (Vercel Cron)
# Generate with: openssl rand -hex 32
# Must match Authorization: Bearer <secret> sent by Vercel Cron
# -----------------------------------------------------------------------------
CRON_SECRET=
